<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="CopyLumiaFoundationLoggerNlogConfig" BeforeTargets="Build">
    <PropertyGroup>
      <_LumiaFoundationLoggerConfigSource>$(MSBuildThisFileDirectory)Config\nlog.config</_LumiaFoundationLoggerConfigSource>
      <_LumiaFoundationLoggerConfigDestination>$(MSBuildProjectDirectory)\nlog.config</_LumiaFoundationLoggerConfigDestination>
    </PropertyGroup>

    <Copy
      SourceFiles="$(_LumiaFoundationLoggerConfigSource)"
      DestinationFiles="$(_LumiaFoundationLoggerConfigDestination)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_LumiaFoundationLoggerConfigSource)')" />
  </Target>
</Project>
